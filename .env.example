# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Anthropic API key. The Anthropic SDK reads this automatically.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon in production; set in Vercel).
# Not needed for local tests, which use an in-process database.
DATABASE_URL=

# Secret Vercel Cron sends to /api/cron/cleanup-expired-sessions (any long random string).
# Without it the cleanup endpoint refuses every request.
CRON_SECRET=

# Salt for hashing visitor IPs (new-Demo-Session rate limit). Any long random string.
DEMO_SESSION_IP_SALT=
